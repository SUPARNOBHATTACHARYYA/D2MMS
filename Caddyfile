http://:8080, http://127.0.0.1:8080 {
    root * docs
    file_server

    # Compression
    encode zstd gzip

    # Development: Never cache HTML, CSS, JS during preview
    @no_cache {
        path *.html *.ipynb *.css *.js
        path_regexp ^/$
    }
    header @no_cache {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    @static_assets {
        path *.pdf *.wasm *.svg *.png *.jpg *.jpeg *.ico *.woff *.woff2
    }
    header @static_assets {
        Cache-Control "public, max-age=31536000, immutable"
    }

    @pdf_files {
        path *.pdf
    }
    header @pdf_files {
        Content-Disposition "inline"
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
